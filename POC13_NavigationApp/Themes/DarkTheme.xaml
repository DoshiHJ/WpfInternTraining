<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->

    <SolidColorBrush
        x:Key="WindowBackgroundBrush"
        Color="#1E1E1E"/>

    <!-- Navigation -->

    <SolidColorBrush
        x:Key="NavigationBackgroundBrush"
        Color="#252526"/>

    <!-- Text -->

    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="White"/>

    <!-- Card -->

    <SolidColorBrush
        x:Key="CardBackgroundBrush"
        Color="#333333"/>

    <!-- Border -->

    <SolidColorBrush
        x:Key="BorderBrushColor"
        Color="#555555"/>

</ResourceDictionary>