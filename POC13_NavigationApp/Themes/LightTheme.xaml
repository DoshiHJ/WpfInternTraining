<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background -->

    <SolidColorBrush
        x:Key="WindowBackgroundBrush"
        Color="White"/>

    <!-- Panel -->

    <SolidColorBrush
        x:Key="NavigationBackgroundBrush"
        Color="LightGray"/>

    <!-- Text -->

    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="Black"/>

    <!-- Card -->

    <SolidColorBrush
        x:Key="CardBackgroundBrush"
        Color="White"/>

    <!-- Border -->

    <SolidColorBrush
        x:Key="BorderBrushColor"
        Color="#DDDDDD"/>

</ResourceDictionary>