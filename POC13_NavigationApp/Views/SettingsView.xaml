<UserControl x:Class="POC13_NavigationApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="25">

        <TextBlock
        Text="⚙ Settings"
        FontSize="28"
        FontWeight="Bold"
        Margin="0,0,0,25"/>

        <GroupBox Header="Appearance">

            <StackPanel Margin="10">

                <RadioButton
                Content="Light Theme"
                IsChecked="{Binding IsLightTheme}"/>

                <RadioButton
                Content="Dark Theme"
                Margin="0,10,0,0"
                IsChecked="{Binding IsDarkTheme}"/>

            </StackPanel>

        </GroupBox>

        <GroupBox Header="Interface"
          Margin="0,20,0,0">

            <StackPanel Margin="10">

                <CheckBox
                Content="Show Navigation Menu"
                IsChecked="{Binding ShowNavigationMenu}"
                Margin="0,10"/>

                <CheckBox
    Content="Open Maximized"
    IsChecked="{Binding StartMaximized}"
    Margin="0,10"/>

                <CheckBox
    Content="Remember Last Opened Page"
    IsChecked="{Binding RememberLastPage}"
    Margin="0,10"/>

                <CheckBox
    Content="Start With Windows"
    Margin="0,10"
    IsChecked="{Binding StartWithWindows}"/>


            </StackPanel>

        </GroupBox>


    </StackPanel>

</UserControl>