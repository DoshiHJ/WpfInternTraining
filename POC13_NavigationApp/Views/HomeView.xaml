<UserControl x:Class="POC13_NavigationApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="10"
        Padding="20"
        Background="White">

        <StackPanel>

            <TextBlock
                Text="{Binding WelcomeMessage}"
                FontSize="28"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,10"/>


        </StackPanel>

    </Border>

</UserControl>